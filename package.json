{
  "name": "issue-harness",
  "version": "0.1.0",
  "description": "A bounded, durable agent harness for GitHub issue work and deterministic evaluation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KarlvonPoncet/github-issue-fixing-harness.git"
  },
  "bugs": {
    "url": "https://github.com/KarlvonPoncet/github-issue-fixing-harness/issues"
  },
  "keywords": [
    "github",
    "issue",
    "agent",
    "benchmark",
    "harness"
  ],
  "type": "module",
  "bin": {
    "issue-harness": "dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package:check": "node scripts/check-package.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bench:reference": "node --import tsx src/cli.ts bench summary --solutions",
    "demo": "node --import tsx src/cli.ts demo",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.84.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
